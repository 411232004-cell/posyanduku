  <diagram id="database-erd" name="3 - Rancangan Database">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="db-title" value="RANCANGAN DATABASE — CLOUD FIRESTORE" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1200" height="40" as="geometry"/></mxCell>
        <mxCell id="db-sub" value="Koleksi, kunci dokumen, atribut representatif, dan referensi antar-dokumen" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#526579;" vertex="1" parent="1"><mxGeometry x="42" y="66" width="1100" height="28" as="geometry"/></mxCell>
        <mxCell id="db-users" value="&lt;b&gt;users/{uid}&lt;/b&gt;&lt;br&gt;PK: uid (ID dokumen)&lt;br&gt;username, nama&lt;br&gt;email, role&lt;br&gt;createdAt" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#EAF3F8;strokeColor=#4E7A96;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="220" height="125" as="geometry"/></mxCell>
        <mxCell id="db-profil" value="&lt;b&gt;config/profil&lt;/b&gt;&lt;br&gt;ID dokumen: profil&lt;br&gt;namaPosyandu&lt;br&gt;namaKelurahan, namaPuskesmas&lt;br&gt;alamat, kontak, identitas" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#F1F5F9;strokeColor=#8192A5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="125" width="250" height="125" as="geometry"/></mxCell>
        <mxCell id="db-targets" value="&lt;b&gt;config/targets&lt;/b&gt;&lt;br&gt;ID dokumen: targets&lt;br&gt;Konfigurasi target pemantauan&lt;br&gt;(atribut sesuai konfigurasi)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#F1F5F9;strokeColor=#8192A5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="590" y="125" width="250" height="125" as="geometry"/></mxCell>
        <mxCell id="db-sesi" value="&lt;b&gt;sesi/{id}&lt;/b&gt;&lt;br&gt;PK: id&lt;br&gt;tanggal, jam, lokasi&lt;br&gt;kegiatan, catatan&lt;br&gt;createdAt" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#F1F5F9;strokeColor=#8192A5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="880" y="125" width="220" height="125" as="geometry"/></mxCell>
        <mxCell id="db-edaran" value="&lt;b&gt;edaran/{id}&lt;/b&gt;&lt;br&gt;PK: id&lt;br&gt;judul, nomor, tanggal&lt;br&gt;isi, penandatangan&lt;br&gt;createdAt" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#F1F5F9;strokeColor=#8192A5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1140" y="125" width="240" height="125" as="geometry"/></mxCell>
        <mxCell id="db-anak" value="&lt;b&gt;anak/{nik}&lt;/b&gt;&lt;br&gt;PK: nik&lt;br&gt;nama, tanggalLahir, jenisKelamin&lt;br&gt;namaIbu/namaAyah, rw, rt&lt;br&gt;alamat, noTelp, pin, createdAt" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#E7F5EE;strokeColor=#579473;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="330" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="db-ibu" value="&lt;b&gt;ibu/{nik}&lt;/b&gt;&lt;br&gt;PK: nik&lt;br&gt;nama, status, tanggalLahir&lt;br&gt;hpht, rw, rt&lt;br&gt;alamat, noTelp, createdAt" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#FCE8E8;strokeColor=#B96666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="850" y="330" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="db-att" value="&lt;b&gt;kehadiran/{nik_bulan}&lt;/b&gt;&lt;br&gt;ID: gabungan nik + bulan&lt;br&gt;nik (ref → anak.nik)&lt;br&gt;nama, rw, rt, bulan&lt;br&gt;tanggal, createdAt" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#FFF4E5;strokeColor=#C48A39;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="605" width="250" height="145" as="geometry"/></mxCell>
        <mxCell id="db-pengukuran" value="&lt;b&gt;pengukuran/{nik_bulan}&lt;/b&gt;&lt;br&gt;ID: gabungan nik + bulan&lt;br&gt;nik (ref → anak.nik)&lt;br&gt;bb, tb, lk, lila, umurBln&lt;br&gt;indikator gizi, tanggal" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#FFF4E5;strokeColor=#C48A39;fontSize=13;" vertex="1" parent="1"><mxGeometry x="340" y="605" width="270" height="145" as="geometry"/></mxCell>
        <mxCell id="db-imunisasi" value="&lt;b&gt;imunisasi/{nik_vaksin}&lt;/b&gt;&lt;br&gt;ID: gabungan nik + vaksin&lt;br&gt;nik (ref → anak.nik)&lt;br&gt;vaksin, namaVaksin&lt;br&gt;tanggal, bulan, createdAt" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#FFF4E5;strokeColor=#C48A39;fontSize=13;" vertex="1" parent="1"><mxGeometry x="660" y="605" width="270" height="145" as="geometry"/></mxCell>
        <mxCell id="db-kunjungan" value="&lt;b&gt;kunjunganIbu/{nik_bulan}&lt;/b&gt;&lt;br&gt;ID: gabungan nik + bulan&lt;br&gt;nik (ref → ibu.nik)&lt;br&gt;bb, tdSys, tdDia, lila, tfu&lt;br&gt;usiaMinggu, keluhan, tanggal" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#FFF4E5;strokeColor=#C48A39;fontSize=13;" vertex="1" parent="1"><mxGeometry x="980" y="605" width="285" height="145" as="geometry"/></mxCell>
        <mxCell id="db-push" value="&lt;b&gt;pushSubs/{id}&lt;/b&gt;&lt;br&gt;PK: id subscription&lt;br&gt;nik (ref → anak.nik)&lt;br&gt;endpoint, keys&lt;br&gt;createdAt" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#F1EDFA;strokeColor=#8C78B8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1300" y="605" width="240" height="145" as="geometry"/></mxCell>
        <mxCell id="db-r1" value="1 : N (nik)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=none;startArrow=none;strokeColor=#579473;fontSize=12;" edge="1" parent="1" source="db-anak" target="db-att"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="db-r2" value="1 : N (nik)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=none;startArrow=none;strokeColor=#579473;fontSize=12;" edge="1" parent="1" source="db-anak" target="db-pengukuran"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="db-r3" value="1 : N (nik)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=none;startArrow=none;strokeColor=#579473;fontSize=12;" edge="1" parent="1" source="db-anak" target="db-imunisasi"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="db-r4" value="1 : N (nik)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=none;startArrow=none;strokeColor=#B96666;fontSize=12;" edge="1" parent="1" source="db-ibu" target="db-kunjungan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="db-r5" value="1 : N (nik)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=none;startArrow=none;strokeColor=#579473;fontSize=12;" edge="1" parent="1" source="db-anak" target="db-push"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="db-note" value="Keterangan: Firestore adalah basis data NoSQL berbasis dokumen. Relasi putus-putus menunjukkan referensi logis melalui atribut nik, bukan foreign key relasional. ID gabungan digunakan untuk pencatatan bulanan/vaksin. Profil dan targets disimpan sebagai dokumen tunggal dalam config. Autentikasi dikelola Firebase Authentication; users menyimpan profil dan peran petugas. Mode demo menggunakan LocalStorage dengan struktur data sepadan." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=10;fontSize=12;fillColor=#F1F5F9;strokeColor=#A8B6C3;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="805" width="1500" height="105" as="geometry"/></mxCell>
        <mxCell id="db-legend" value="PK = primary key / ID dokumen   •   1 : N = satu data induk dapat direferensikan oleh banyak catatan" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#526579;" vertex="1" parent="1"><mxGeometry x="40" y="925" width="1200" height="28" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
